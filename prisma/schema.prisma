// SpareFit data model. See .claude/specs/data-model.md (history: .claude/archive/BUILD-PLAN.md §3).
// Every app table carries shopId and cascades on shop delete, so a shop purge is one delete.

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// Shopify session storage (@shopify/shopify-app-session-storage-prisma). Shape is fixed by the library.
model Session {
  id                  String    @id
  shop                String
  state               String
  isOnline            Boolean   @default(false)
  scope               String?
  expires             DateTime?
  accessToken         String
  userId              BigInt?
  firstName           String?
  lastName            String?
  email               String?
  accountOwner        Boolean   @default(false)
  locale              String?
  collaborator        Boolean?  @default(false)
  emailVerified       Boolean?  @default(false)
  refreshToken        String?
  refreshTokenExpires DateTime?
}

model Shop {
  id             String    @id @default(cuid())
  domain         String    @unique
  installedAt    DateTime  @default(now()) @map("installed_at")
  uninstalledAt  DateTime? @map("uninstalled_at")
  // Last token exchange or admin visit. An uninstall webhook triggered before this is stale
  // (the shop has reinstalled since) and is ignored.
  lastAuthAt     DateTime  @default(now()) @map("last_auth_at")
  // A plan key (plans.key), or "none" before the first plan is picked (app/services/billing.ts).
  plan           String    @default("none")
  trialEndsAt    DateTime? @map("trial_ends_at")
  // The Billing API subscription that is active (app_subscriptions.shopify_id), or null.
  subscriptionId String?   @map("subscription_id")
  createdAt      DateTime  @default(now()) @map("created_at")
  updatedAt      DateTime  @updatedAt @map("updated_at")

  searchConfig       SearchConfig?
  searchFields       SearchField[]
  fitmentRows        FitmentRow[]
  productLinks       ProductLink[]
  universalProducts  UniversalProduct[]
  importMappings     ImportMapping[]
  importJobs         ImportJob[]
  storefrontSettings StorefrontSettings?
  themeStatuses      ThemeStatus[]
  catalogProducts    CatalogProduct[]
  catalogVariants    CatalogVariant[]
  catalogSync        CatalogSync?
  searchStats        SearchStat[]
  fitCheckStats      FitCheckStat[]
  appSubscriptions   AppSubscription[]

  @@index([uninstalledAt])
  @@map("shops")
}

enum StoreType {
  automotive
  phones
  beauty
  custom
}

model SearchConfig {
  shopId      String    @id @map("shop_id")
  storeType   StoreType @map("store_type")
  heading     String
  noun        String
  thingsWord  String    @map("things_word")
  // Bumped by every write that takes the setup lock (rows, fields, imports, replace), so the
  // storefront's cached dropdown options know when to recompute.
  dataVersion Int       @default(0) @map("data_version")
  updatedAt   DateTime  @updatedAt @map("updated_at")

  shop Shop @relation(fields: [shopId], references: [id], onDelete: Cascade)

  @@map("search_configs")
}

enum FieldType {
  list
  year_range
}

model SearchField {
  id          String    @id @default(cuid())
  shopId      String    @map("shop_id")
  position    Int
  label       String
  placeholder String    @default("")
  type        FieldType @default(list)
  required    Boolean   @default(true)

  shop Shop @relation(fields: [shopId], references: [id], onDelete: Cascade)

  @@index([shopId, position])
  @@map("search_fields")
}

// Shops can hold 700k+ rows, hence BigInt ids and the GIN index on values.
model FitmentRow {
  id         BigInt   @id @default(autoincrement())
  shopId     String   @map("shop_id")
  // { [searchFieldId]: value } for list fields; year ranges live in yearFrom/yearTo.
  // "values" is a reserved word in Postgres: quote it in raw SQL.
  values     Json
  yearFrom   Int?     @map("year_from")
  // null = open range ("2016-")
  yearTo     Int?     @map("year_to")
  // the product SKU this row fits (matched to a variant SKU, case and outer spaces ignored)
  attachment String
  // hash(values + years + attachment): upsert key and dedupe
  rowHash    String   @map("row_hash")
  createdAt  DateTime @default(now()) @map("created_at")
  updatedAt  DateTime @updatedAt @map("updated_at")

  shop Shop @relation(fields: [shopId], references: [id], onDelete: Cascade)

  @@unique([shopId, rowHash])
  // Filter data pages (newest first) and export batches (keyset by id) per shop.
  @@index([shopId, id])
  // Covering for the unlinked groups on Product mapping (GROUP BY attachment, min(id)).
  @@index([shopId, attachment, id])
  @@index([values(ops: JsonbPathOps)], type: Gin)
  @@map("fitment_rows")
}

enum LinkMethod {
  auto
  manual
}

model ProductLink {
  id         String     @id @default(cuid())
  shopId     String     @map("shop_id")
  attachment String
  productId  String     @map("product_id")
  variantId  String?    @map("variant_id")
  method     LinkMethod @default(auto)
  updatedAt  DateTime   @updatedAt @map("updated_at")

  shop Shop @relation(fields: [shopId], references: [id], onDelete: Cascade)

  @@unique([shopId, attachment])
  @@index([shopId, productId])
  @@map("product_links")
}

model UniversalProduct {
  shopId    String   @map("shop_id")
  productId String   @map("product_id")
  createdAt DateTime @default(now()) @map("created_at")

  shop Shop @relation(fields: [shopId], references: [id], onDelete: Cascade)

  @@id([shopId, productId])
  @@map("universal_products")
}

// Last saved column mapping; pre-fills step 2 of the next import.
model ImportMapping {
  shopId     String @map("shop_id")
  columnName String @map("column_name")
  // field:{id} | field:{id}:from | field:{id}:to | field:{id}:range | attachment | skip
  target     String

  shop Shop @relation(fields: [shopId], references: [id], onDelete: Cascade)

  @@id([shopId, columnName])
  @@map("import_mappings")
}

enum ImportMode {
  upsert
  replace
  delete
}

enum ImportStatus {
  uploaded // file stored, columns read; waiting for the mapping
  previewing // check run: staging rows and counting (job)
  ready // counts ready for Review
  running // applying to fitment_rows (job)
  completed
  failed
  cancelled
}

model ImportJob {
  id            String       @id @default(cuid())
  shopId        String       @map("shop_id")
  fileName      String       @map("file_name")
  // object storage key of the original upload; cleared when the file falls out of the last 5
  fileKey       String?      @map("file_key")
  fileSize      BigInt?      @map("file_size")
  mode          ImportMode   @default(upsert)
  // { [columnIndex]: target }; target = field:{id} | field:{id}:from|to|range | attachment
  mapping       Json?
  // [{ name, samples: string[] }] read from the file at upload
  columns       Json?
  delimiter     String?
  encoding      String?
  hasHeader     Boolean      @default(true) @map("has_header")
  status        ImportStatus @default(uploaded)
  // Each queued step carries this number; a worker only runs the step it was queued for.
  attempt       Int          @default(0)
  // Set when a worker claims the queued step; null while it waits in the queue.
  claimedAt     DateTime?    @map("claimed_at")
  // progress of the running phase (rows read from the file)
  processedRows Int          @default(0) @map("processed_rows")
  totalRows     Int?         @map("total_rows")
  // review and result counts
  added         Int          @default(0)
  unchanged     Int          @default(0)
  imported      Int          @default(0)
  deleted       Int          @default(0)
  notFound      Int          @default(0) @map("not_found")
  rowsLeft      Int          @default(0) @map("rows_left")
  errors        Int          @default(0)
  // error report (add / replace) or not-found report (delete), in object storage
  reportKey     String?      @map("report_key")
  failureReason String?      @map("failure_reason")
  createdAt     DateTime     @default(now()) @map("created_at")
  updatedAt     DateTime     @default(now()) @updatedAt @map("updated_at")
  finishedAt    DateTime?    @map("finished_at")

  shop Shop        @relation(fields: [shopId], references: [id], onDelete: Cascade)
  rows ImportRow[]

  @@index([shopId, createdAt])
  @@index([shopId, status])
  @@map("import_jobs")
}

// Staging rows of an import: parsed once by the check run, then applied by the run, so the
// Review counts and the result match exactly. Deleted when the job finishes or is cancelled.
// Columns mirror fitment_rows ("values", year_from, year_to, attachment) so rowHashSql applies.
model ImportRow {
  id         BigInt  @id @default(autoincrement())
  jobId      String  @map("job_id")
  line       Int
  values     Json    @default("{}")
  yearFrom   Int?    @map("year_from")
  yearTo     Int?    @map("year_to")
  attachment String  @default("")
  rowHash    String? @map("row_hash")
  // why the row can not be imported; null = valid
  error      String?
  // the mapped cells as read, kept for error rows (report)
  raw        Json?

  job ImportJob @relation(fields: [jobId], references: [id], onDelete: Cascade)

  @@index([jobId, rowHash])
  @@index([jobId, id])
  @@map("import_rows")
}

// Every Storefront-page setting (keys in .claude/specs/data-model.md); mirrored to an app metafield.
model StorefrontSettings {
  shopId          String    @id @map("shop_id")
  settings        Json      @default("{}")
  // Hash of the config last written to the app metafield; the admin republishes when it differs.
  publishedHash   String?   @map("published_hash")
  // A publish in progress holds this lease (one UPDATE claims it; nothing stays open while
  // Shopify answers). Expires on its own if the process dies.
  publishingUntil DateTime? @map("publishing_until")
  // What the first dropdown list in the app metafield sparefit.first was computed for (install
  // time, data version, first field, year). The admin queues a background publish when it differs.
  firstPublished  String?   @map("first_published")
  updatedAt       DateTime  @updatedAt @map("updated_at")

  shop Shop @relation(fields: [shopId], references: [id], onDelete: Cascade)

  @@map("storefront_settings")
}

// Cache of what is added to each theme.
model ThemeStatus {
  shopId         String   @map("shop_id")
  themeId        String   @map("theme_id")
  embedOn        Boolean  @default(false) @map("embed_on")
  blocks         Json     @default("{}")
  tableCodeFound Boolean  @default(false) @map("table_code_found")
  checkedAt      DateTime @default(now()) @map("checked_at")

  shop Shop @relation(fields: [shopId], references: [id], onDelete: Cascade)

  @@id([shopId, themeId])
  @@map("theme_status")
}

// ---------------------------------------------------------------- linking (M6)
// Copy of the store's products and variants, so rows link to products in SQL
// (specs/product-mapping.md). Filled by a bulk operation (Check links again, first visit) and kept
// fresh by products/* webhooks. Ids are Admin GraphQL gids.

model CatalogProduct {
  shopId    String   @map("shop_id")
  productId String   @map("product_id")
  title     String
  // lower case, as Shopify stores handles
  handle    String
  // ACTIVE | DRAFT | ARCHIVED (Admin GraphQL ProductStatus)
  status    String
  // Product tags as Shopify returns them (results page filters)
  tags      String[] @default([])
  updatedAt DateTime @default(now()) @updatedAt @map("updated_at")

  shop Shop @relation(fields: [shopId], references: [id], onDelete: Cascade)

  @@id([shopId, productId])
  @@index([shopId, handle])
  @@index([shopId, title])
  @@map("catalog_products")
}

model CatalogVariant {
  shopId    String @map("shop_id")
  variantId String @map("variant_id")
  productId String @map("product_id")
  sku       String @default("")
  // lower(trim(sku)): attachments match SKUs regardless of case and outer spaces
  skuKey    String @default("") @map("sku_key")

  shop Shop @relation(fields: [shopId], references: [id], onDelete: Cascade)

  @@id([shopId, variantId])
  @@index([shopId, skuKey])
  @@index([shopId, productId])
  @@map("catalog_variants")
}

enum LinkCheckStatus {
  queued
  running
  completed
  failed
}

// The shop's link check (pg-boss queue "links"): optional catalog sync, then matching.
model CatalogSync {
  shopId          String          @id @map("shop_id")
  status          LinkCheckStatus @default(queued)
  // true: reload the catalog from Shopify first; false: only match rows against the cache
  fullSync        Boolean         @default(true) @map("full_sync")
  // Each queued run carries this number; a worker only runs the run it was queued for.
  attempt         Int             @default(0)
  bulkOperationId String?         @map("bulk_operation_id")
  newMatches      Int             @default(0) @map("new_matches")
  error           String?
  startedAt       DateTime        @default(now()) @map("started_at")
  finishedAt      DateTime?       @map("finished_at")
  // last successful catalog sync; null = the cache was never filled
  syncedAt        DateTime?       @map("synced_at")
  // the last full sync read product tags (false: cache filled before tags were kept)
  tagsLoaded      Boolean         @default(false) @map("tags_loaded")
  // A check asked for while one was running: run again when it ends (true = with catalog sync).
  pendingFullSync Boolean?        @map("pending_full_sync")
  // heartbeat while running
  updatedAt       DateTime        @default(now()) @updatedAt @map("updated_at")

  shop Shop @relation(fields: [shopId], references: [id], onDelete: Cascade)

  @@map("catalog_syncs")
}

// The four plans, edited in the backoffice (specs/backoffice.md). Global, not per shop. limits and
// toggles are JSON objects keyed as in app/services/plan-features.ts (a limit of null = unlimited).
model Plan {
  key          String   @id
  position     Int
  name         String
  description  String   @default("")
  isFree       Boolean  @default(false) @map("is_free")
  priceMonthly Decimal  @default(0) @map("price_monthly") @db.Decimal(10, 2)
  priceYearly  Decimal? @map("price_yearly") @db.Decimal(10, 2)
  trialDays    Int      @default(14) @map("trial_days")
  visible      Boolean  @default(true)
  limits       Json     @default("{}")
  toggles      Json     @default("{}")
  bullets      String[] @default([])
  /// Generated lines before each extra line (same order as bullets); missing = at the end.
  bulletsAt    Int[]    @default([]) @map("bullets_at")
  updatedAt    DateTime @default(now()) @updatedAt @map("updated_at")
  updatedBy    String?  @map("updated_by")

  @@map("plans")
}

// A Billing API charge the app created, so a Shopify subscription maps back to our plan even after
// the plan is renamed. Price and trial are what the merchant approved. activatedAt/endedAt give
// the trial days a shop has used (kept across reinstalls until the shop is purged).
model AppSubscription {
  id          String    @id @default(cuid())
  shopId      String    @map("shop_id")
  shopifyId   String    @unique @map("shopify_id")
  planKey     String    @map("plan_key")
  interval    String
  price       Decimal   @db.Decimal(10, 2)
  trialDays   Int       @map("trial_days")
  status      String    @default("PENDING")
  activatedAt DateTime? @map("activated_at")
  endedAt     DateTime? @map("ended_at")
  createdAt   DateTime  @default(now()) @map("created_at")
  updatedAt   DateTime  @updatedAt @map("updated_at")

  shop Shop @relation(fields: [shopId], references: [id], onDelete: Cascade)

  @@index([shopId])
  @@map("app_subscriptions")
}

// ---------------------------------------------------------------- analytics
// Storefront use, counted per UTC day for the Analytics page (specs/analytics.md). Counts only:
// nothing about the shopper (no ids, IPs or sessions). Rows older than 180 days are deleted by
// the daily purge job.

// One row per selection per day: "Show {products}" clicks (app proxy /search).
model SearchStat {
  shopId       String   @map("shop_id")
  day          DateTime @db.Date
  // md5 of the picks, so the key stays short however long the values are
  selectionKey String   @map("selection_key")
  // { [searchFieldId]: value } as the shopper picked it (strings)
  picks        Json
  searches     Int      @default(0)
  // searches where no product fitted (universal products don't count)
  noResults    Int      @default(0) @map("no_results")

  shop Shop @relation(fields: [shopId], references: [id], onDelete: Cascade)

  @@id([shopId, day, selectionKey])
  @@map("search_stats")
}

// One row per product per day: fits badge checks with the shopper's selection (app proxy /fits).
model FitCheckStat {
  shopId    String   @map("shop_id")
  day       DateTime @db.Date
  productId String   @map("product_id")
  fits      Int      @default(0)
  noFit     Int      @default(0) @map("no_fit")

  shop Shop @relation(fields: [shopId], references: [id], onDelete: Cascade)

  @@id([shopId, day, productId])
  @@map("fit_check_stats")
}

// The backoffice super admin once the profile has been saved (specs/backoffice.md). Until then
// the BACKOFFICE_EMAIL / BACKOFFICE_PASSWORD env values sign in. One row (id 1). `version` goes
// up on every password or email change, which signs out other sessions.
model BackofficeAdmin {
  id           Int      @id @default(1)
  name         String   @default("")
  email        String
  passwordHash String   @map("password_hash")
  version      Int      @default(1)
  updatedAt    DateTime @updatedAt @map("updated_at")

  @@map("backoffice_admins")
}

// Backoffice › Logs (specs/backoffice.md): warnings, errors and slow requests from the app and
// the job worker. Repeats of the same entry within an hour are one row (count, first/last seen).
// Not tied to the shop row: app-wide entries have no shop; a purged shop's entries are deleted
// with it (purge.server.ts). Kept for the retention set in the backoffice (7, 14 or 30 days).
enum LogLevel {
  error
  warn
  slow // a request slower than the threshold (performance)
}

model AppLog {
  id          String   @id @default(cuid())
  level       LogLevel
  // Where it came from: the message's area ("storefront", "import"…), a route, or "request".
  source      String
  message     String
  // Stack and the extra values logged with it (secrets and emails removed).
  detail      String?
  shopDomain  String?  @map("shop_domain")
  // Request path and duration for slow requests and route errors.
  path        String?
  durationMs  Int?     @map("duration_ms")
  // Same level + source + message + shop within an hour → the same row.
  fingerprint String
  count       Int      @default(1)
  firstAt     DateTime @default(now()) @map("first_at")
  lastAt      DateTime @default(now()) @map("last_at")

  @@index([lastAt])
  @@index([level, lastAt])
  @@index([shopDomain, lastAt])
  @@index([fingerprint, lastAt])
  @@map("app_logs")
}

// App-wide settings the super admin changes in the backoffice, one row per key.
model BackofficeSetting {
  key       String   @id
  value     Json
  updatedAt DateTime @updatedAt @map("updated_at")

  @@map("backoffice_settings")
}
