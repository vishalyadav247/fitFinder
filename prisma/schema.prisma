// FitFinder data model. See .claude/BUILD-PLAN.md §3 and .claude/specs/data-model.md.
// Every app table carries shopId and cascades on shop delete, so a shop purge is one delete.

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// Shopify session storage (@shopify/shopify-app-session-storage-prisma). Shape is fixed by the library.
model Session {
  id                  String    @id
  shop                String
  state               String
  isOnline            Boolean   @default(false)
  scope               String?
  expires             DateTime?
  accessToken         String
  userId              BigInt?
  firstName           String?
  lastName            String?
  email               String?
  accountOwner        Boolean   @default(false)
  locale              String?
  collaborator        Boolean?  @default(false)
  emailVerified       Boolean?  @default(false)
  refreshToken        String?
  refreshTokenExpires DateTime?
}

model Shop {
  id            String    @id @default(cuid())
  domain        String    @unique
  installedAt   DateTime  @default(now()) @map("installed_at")
  uninstalledAt DateTime? @map("uninstalled_at")
  // Last token exchange or admin visit. An uninstall webhook triggered before this is stale
  // (the shop has reinstalled since) and is ignored.
  lastAuthAt    DateTime  @default(now()) @map("last_auth_at")
  plan          String    @default("starter")
  trialEndsAt   DateTime? @map("trial_ends_at")
  createdAt     DateTime  @default(now()) @map("created_at")
  updatedAt     DateTime  @updatedAt @map("updated_at")

  searchConfig       SearchConfig?
  searchFields       SearchField[]
  fitmentRows        FitmentRow[]
  productLinks       ProductLink[]
  universalProducts  UniversalProduct[]
  importMappings     ImportMapping[]
  importJobs         ImportJob[]
  storefrontSettings StorefrontSettings?
  themeStatuses      ThemeStatus[]
  catalogProducts    CatalogProduct[]
  catalogVariants    CatalogVariant[]
  catalogCollections CatalogCollection[]
  catalogSync        CatalogSync?

  @@index([uninstalledAt])
  @@map("shops")
}

enum StoreType {
  automotive
  phones
  beauty
  custom
}

model SearchConfig {
  shopId     String    @id @map("shop_id")
  storeType  StoreType @map("store_type")
  heading    String
  noun       String
  thingsWord String    @map("things_word")
  updatedAt  DateTime  @updatedAt @map("updated_at")

  shop Shop @relation(fields: [shopId], references: [id], onDelete: Cascade)

  @@map("search_configs")
}

enum FieldType {
  list
  year_range
}

model SearchField {
  id          String    @id @default(cuid())
  shopId      String    @map("shop_id")
  position    Int
  label       String
  placeholder String    @default("")
  type        FieldType @default(list)
  required    Boolean   @default(true)

  shop Shop @relation(fields: [shopId], references: [id], onDelete: Cascade)

  @@index([shopId, position])
  @@map("search_fields")
}

// Shops can hold 700k+ rows, hence BigInt ids and the GIN index on values.
model FitmentRow {
  id         BigInt   @id @default(autoincrement())
  shopId     String   @map("shop_id")
  // { [searchFieldId]: value } for list fields; year ranges live in yearFrom/yearTo.
  // "values" is a reserved word in Postgres: quote it in raw SQL.
  values     Json
  yearFrom   Int?     @map("year_from")
  // null = open range ("2016-")
  yearTo     Int?     @map("year_to")
  // SKU, product URL/handle or collection URL/handle
  attachment String
  // hash(values + years + attachment): upsert key and dedupe
  rowHash    String   @map("row_hash")
  createdAt  DateTime @default(now()) @map("created_at")
  updatedAt  DateTime @updatedAt @map("updated_at")

  shop Shop @relation(fields: [shopId], references: [id], onDelete: Cascade)

  @@unique([shopId, rowHash])
  // Filter data pages (newest first) and export batches (keyset by id) per shop.
  @@index([shopId, id])
  @@index([shopId, attachment])
  @@index([values(ops: JsonbPathOps)], type: Gin)
  @@map("fitment_rows")
}

enum LinkKind {
  sku
  product
  collection
}

enum LinkMethod {
  auto
  manual
}

model ProductLink {
  id           String     @id @default(cuid())
  shopId       String     @map("shop_id")
  attachment   String
  kind         LinkKind
  productId    String?    @map("product_id")
  variantId    String?    @map("variant_id")
  collectionId String?    @map("collection_id")
  method       LinkMethod @default(auto)
  updatedAt    DateTime   @updatedAt @map("updated_at")

  shop Shop @relation(fields: [shopId], references: [id], onDelete: Cascade)

  @@unique([shopId, attachment])
  @@index([shopId, productId])
  @@map("product_links")
}

model UniversalProduct {
  shopId    String   @map("shop_id")
  productId String   @map("product_id")
  createdAt DateTime @default(now()) @map("created_at")

  shop Shop @relation(fields: [shopId], references: [id], onDelete: Cascade)

  @@id([shopId, productId])
  @@map("universal_products")
}

// Last saved column mapping; pre-fills step 2 of the next import.
model ImportMapping {
  shopId     String @map("shop_id")
  columnName String @map("column_name")
  // field:{id} | field:{id}:from | field:{id}:to | field:{id}:range | attachment | skip
  target     String

  shop Shop @relation(fields: [shopId], references: [id], onDelete: Cascade)

  @@id([shopId, columnName])
  @@map("import_mappings")
}

enum ImportMode {
  upsert
  replace
  delete
}

enum ImportStatus {
  uploaded // file stored, columns read; waiting for the mapping
  previewing // check run: staging rows and counting (job)
  ready // counts ready for Review
  running // applying to fitment_rows (job)
  completed
  failed
  cancelled
}

model ImportJob {
  id            String       @id @default(cuid())
  shopId        String       @map("shop_id")
  fileName      String       @map("file_name")
  // object storage key of the original upload; cleared when the file falls out of the last 5
  fileKey       String?      @map("file_key")
  fileSize      BigInt?      @map("file_size")
  mode          ImportMode   @default(upsert)
  // { [columnIndex]: target }; target = field:{id} | field:{id}:from|to|range | attachment
  mapping       Json?
  // [{ name, samples: string[] }] read from the file at upload
  columns       Json?
  delimiter     String?
  encoding      String?
  lookForSkus   Boolean      @default(true) @map("look_for_skus")
  hasHeader     Boolean      @default(true) @map("has_header")
  status        ImportStatus @default(uploaded)
  // Each queued step carries this number; a worker only runs the step it was queued for.
  attempt       Int          @default(0)
  // Set when a worker claims the queued step; null while it waits in the queue.
  claimedAt     DateTime?    @map("claimed_at")
  // progress of the running phase (rows read from the file)
  processedRows Int          @default(0) @map("processed_rows")
  totalRows     Int?         @map("total_rows")
  // review and result counts
  added         Int          @default(0)
  unchanged     Int          @default(0)
  imported      Int          @default(0)
  deleted       Int          @default(0)
  notFound      Int          @default(0) @map("not_found")
  rowsLeft      Int          @default(0) @map("rows_left")
  errors        Int          @default(0)
  // error report (add / replace) or not-found report (delete), in object storage
  reportKey     String?      @map("report_key")
  failureReason String?      @map("failure_reason")
  createdAt     DateTime     @default(now()) @map("created_at")
  updatedAt     DateTime     @default(now()) @updatedAt @map("updated_at")
  finishedAt    DateTime?    @map("finished_at")

  shop Shop        @relation(fields: [shopId], references: [id], onDelete: Cascade)
  rows ImportRow[]

  @@index([shopId, createdAt])
  @@index([shopId, status])
  @@map("import_jobs")
}

// Staging rows of an import: parsed once by the check run, then applied by the run, so the
// Review counts and the result match exactly. Deleted when the job finishes or is cancelled.
// Columns mirror fitment_rows ("values", year_from, year_to, attachment) so rowHashSql applies.
model ImportRow {
  id         BigInt  @id @default(autoincrement())
  jobId      String  @map("job_id")
  line       Int
  values     Json    @default("{}")
  yearFrom   Int?    @map("year_from")
  yearTo     Int?    @map("year_to")
  attachment String  @default("")
  rowHash    String? @map("row_hash")
  // why the row can not be imported; null = valid
  error      String?
  // the mapped cells as read, kept for error rows (report)
  raw        Json?

  job ImportJob @relation(fields: [jobId], references: [id], onDelete: Cascade)

  @@index([jobId, rowHash])
  @@index([jobId, id])
  @@map("import_rows")
}

// Every Storefront-page setting (keys in .claude/specs/data-model.md); mirrored to an app metafield.
model StorefrontSettings {
  shopId    String   @id @map("shop_id")
  settings  Json     @default("{}")
  updatedAt DateTime @updatedAt @map("updated_at")

  shop Shop @relation(fields: [shopId], references: [id], onDelete: Cascade)

  @@map("storefront_settings")
}

// Cache of what is added to each theme.
model ThemeStatus {
  shopId         String   @map("shop_id")
  themeId        String   @map("theme_id")
  embedOn        Boolean  @default(false) @map("embed_on")
  blocks         Json     @default("{}")
  tableCodeFound Boolean  @default(false) @map("table_code_found")
  checkedAt      DateTime @default(now()) @map("checked_at")

  shop Shop @relation(fields: [shopId], references: [id], onDelete: Cascade)

  @@id([shopId, themeId])
  @@map("theme_status")
}

// ---------------------------------------------------------------- linking (M6)
// Copy of the store's products, variants and collections, so rows link to products in SQL
// (specs/product-mapping.md). Filled by a bulk operation (Check links again, first visit) and kept
// fresh by products/* webhooks. Ids are Admin GraphQL gids.

model CatalogProduct {
  shopId    String   @map("shop_id")
  productId String   @map("product_id")
  title     String
  // lower case, as Shopify stores handles
  handle    String
  // ACTIVE | DRAFT | ARCHIVED (Admin GraphQL ProductStatus)
  status    String
  updatedAt DateTime @default(now()) @updatedAt @map("updated_at")

  shop Shop @relation(fields: [shopId], references: [id], onDelete: Cascade)

  @@id([shopId, productId])
  @@index([shopId, handle])
  @@index([shopId, title])
  @@map("catalog_products")
}

model CatalogVariant {
  shopId    String @map("shop_id")
  variantId String @map("variant_id")
  productId String @map("product_id")
  sku       String @default("")
  // lower(trim(sku)): attachments match SKUs regardless of case and outer spaces
  skuKey    String @default("") @map("sku_key")

  shop Shop @relation(fields: [shopId], references: [id], onDelete: Cascade)

  @@id([shopId, variantId])
  @@index([shopId, skuKey])
  @@index([shopId, productId])
  @@map("catalog_variants")
}

model CatalogCollection {
  shopId       String @map("shop_id")
  collectionId String @map("collection_id")
  handle       String
  title        String

  shop Shop @relation(fields: [shopId], references: [id], onDelete: Cascade)

  @@id([shopId, collectionId])
  @@index([shopId, handle])
  @@map("catalog_collections")
}

enum LinkCheckStatus {
  queued
  running
  completed
  failed
}

// The shop's link check (pg-boss queue "links"): optional catalog sync, then matching.
model CatalogSync {
  shopId          String          @id @map("shop_id")
  status          LinkCheckStatus @default(queued)
  // true: reload the catalog from Shopify first; false: only match rows against the cache
  fullSync        Boolean         @default(true) @map("full_sync")
  // Each queued run carries this number; a worker only runs the run it was queued for.
  attempt         Int             @default(0)
  bulkOperationId String?         @map("bulk_operation_id")
  newMatches      Int             @default(0) @map("new_matches")
  error           String?
  startedAt       DateTime        @default(now()) @map("started_at")
  finishedAt      DateTime?       @map("finished_at")
  // last successful catalog sync; null = the cache was never filled
  syncedAt        DateTime?       @map("synced_at")
  // A check asked for while one was running: run again when it ends (true = with catalog sync).
  pendingFullSync Boolean?        @map("pending_full_sync")
  // heartbeat while running
  updatedAt       DateTime        @default(now()) @updatedAt @map("updated_at")

  shop Shop @relation(fields: [shopId], references: [id], onDelete: Cascade)

  @@map("catalog_syncs")
}
