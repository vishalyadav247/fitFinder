{%- comment -%}
  FitFinder app embed (specs/storefront.md › My Selection): loads the script and styles on every
  page, shows the floating My Selection button, and on product pages swaps the code
  [fitfinder-table] in the theme's own tabs for the fitment table.
{%- endcomment -%}
{%- assign ff = app.metafields.fitfinder.config.value -%}
{%- if ff -%}
  <script type="application/json" data-ff-config>{{ ff | json }}</script>
  <div hidden data-ff-embed data-search-src="{{ 'ff-search.js' | asset_url }}" data-product-src="{{ 'ff-product.js' | asset_url }}"{% if product and template.name == 'product' %} data-product="{{ product.id }}" data-collections="{{ product.collections | map: 'id' | join: ',' }}"{% endif %}></div>
{%- endif -%}

{% schema %}
{
  "name": "FitFinder",
  "target": "body",
  "javascript": "ff-embed.js",
  "stylesheet": "fitfinder.css",
  "settings": []
}
{% endschema %}
