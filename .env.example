# Copy to .env. `shopify app dev` fills in the Shopify values when it runs.

# Local Postgres (Docker container fitfinder-db; start with `docker start fitfinder-db`)
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/fitfinder

SHOPIFY_API_KEY=
SHOPIFY_API_SECRET=
SHOPIFY_APP_URL=
SCOPES=read_products

# Optional: a custom shop domain to accept in addition to *.myshopify.com
SHOP_CUSTOM_DOMAIN=
