# Copy to .env. `shopify app dev` fills in the Shopify values when it runs.

# Local Postgres (Docker container fitfinder-db; start with `docker start fitfinder-db`)
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/fitfinder

SHOPIFY_API_KEY=
SHOPIFY_API_SECRET=
SHOPIFY_APP_URL=
SCOPES=read_products

# Optional: a custom shop domain to accept in addition to *.myshopify.com
SHOP_CUSTOM_DOMAIN=

# File storage for import uploads and reports: local folder (default) or Cloudflare R2
STORAGE_DRIVER=local
STORAGE_DIR=.data/storage
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET=

# Background jobs run inside the web process; set false and run `npm run worker` separately
JOBS_INLINE=true

# App proxy protection (optional; defaults in app/services/storefront/limits.server.ts).
# Per shop and process: requests per second and burst; storefront queries at once per process
# (keep below the database pool: add ?connection_limit=… to DATABASE_URL in production).
PROXY_SHOP_RATE=
PROXY_SHOP_BURST=
PROXY_MAX_QUERIES=

# Billing (Shopify App Pricing). Partner API client with the "Manage apps" permission;
# org id from the Partner Dashboard URL; app GID = gid://shopify/App/{numeric id};
# app handle from the Partner Dashboard. Without these, billing is "not connected" and every
# shop gets Starter's limits.
SHOPIFY_PARTNER_ORG_ID=
SHOPIFY_PARTNER_API_ACCESS_TOKEN=
SHOPIFY_APP_GID=
SHOPIFY_APP_HANDLE=

# Settings › Help (buttons stay disabled until set)
SUPPORT_EMAIL=
HELP_CENTER_URL=
