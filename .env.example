# Copy to .env. `shopify app dev` fills in the Shopify values when it runs.

# Local Postgres (Docker container sparefit-db; start with `docker start sparefit-db`)
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/sparefit

SHOPIFY_API_KEY=
SHOPIFY_API_SECRET=
SHOPIFY_APP_URL=
SCOPES=read_products,write_app_proxy,read_themes,write_files

# Optional: a custom shop domain to accept in addition to *.myshopify.com
SHOP_CUSTOM_DOMAIN=

# File storage for import uploads and reports: local folder (default) or Cloudflare R2
STORAGE_DRIVER=local
STORAGE_DIR=.data/storage
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET=

# Background jobs run inside the web process; set false and run `npm run worker` separately
JOBS_INLINE=true
# pg-boss schema (default pgboss). Must be the same for the web process and the worker, or
# queued jobs are never picked up. The end-to-end tests use their own (pgboss_e2e).
# PGBOSS_SCHEMA=pgboss
# false skips the daily purge schedule and the stale-import sweep (end-to-end tests only).
# JOBS_SCHEDULES=true

# App proxy protection (optional; defaults in app/services/storefront/limits.server.ts).
# Per shop and process: requests per second and burst; storefront queries at once per process
# (keep below the database pool: add ?connection_limit=… to DATABASE_URL in production).
PROXY_SHOP_RATE=
PROXY_SHOP_BURST=
PROXY_MAX_QUERIES=

# Billing (Billing API / Manual Pricing; plans are edited in the backoffice). App handle from
# shopify.app.toml (default "sparefit"), used in the URL Shopify returns to after a charge.
# SHOPIFY_BILLING_TEST=true makes every charge a test charge (development stores always are).
SHOPIFY_APP_HANDLE=
SHOPIFY_BILLING_TEST=

# Backoffice (/backoffice, super admin for plans). Both, or the backoffice is a 404.
# Password: 12+ characters. The cookie key is derived from these on the server.
BACKOFFICE_EMAIL=
BACKOFFICE_PASSWORD=

# Public landing page (/): App Store listing link (falls back to an App Store search) and the
# privacy policy link in the footer (hidden until set)
APP_STORE_URL=
PRIVACY_POLICY_URL=
